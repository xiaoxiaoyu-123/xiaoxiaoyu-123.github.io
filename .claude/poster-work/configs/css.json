  "code": [
    "<span class=\"c\">/* 通配符：清除默认边距 */</span>",
    "* { <span class=\"k\">margin</span>: 0; <span class=\"k\">padding</span>: 0; }",
    "<span class=\"c\">/* 类选择器：日常最常用的那种 */</span>",
    ".pink { <span class=\"k\">color</span>: pink; <span class=\"k\">font-size</span>: 20px; }",
    "<span class=\"c\">/* 链接伪类：鼠标经过变红 */</span>",
    "a:hover { <span class=\"k\">color</span>: #ff0f23; }",
    "<span class=\"c\">/* 首行缩进两个字，行高 1.5 倍 */</span>",
    "p { <span class=\"k\">text-indent</span>: 2em; <span class=\"k\">line-height</span>: 1.5; }"

    "<span class=\"c\"># 2. 创建并切换到功能分支</span>",
    "<span class=\"k\">git</span> checkout -b feature/功能名称",
    "<span class=\"c\"># 3. 提交并推送自己的分支</span>",
    "<span class=\"k\">git</span> add . &amp;&amp; <span class=\"k\">git</span> commit -m \"功能描述\"",

// ==================================================
// 暖纸墨香：纸感细节样式
// ==================================================

// 背景固定（滚动时纸面不动）
body {
  background-attachment: fixed;
}

// 站点标题增加书卷气字距
.site-title {
  letter-spacing: 2px;
}

// 分隔线用淡棕渐变
hr {
  background-image: linear-gradient(90deg, transparent, rgba(139, 94, 52, .35), transparent);
}

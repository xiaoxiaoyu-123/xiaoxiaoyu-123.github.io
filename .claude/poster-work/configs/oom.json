  "code_file": "oom_fix.sh",
  "code": [
    "<span class=\"c\"># 揪出真凶：谁在吃内存</span>",
    "<span class=\"k\">dmesg</span> -T | <span class=\"k\">grep</span> -iE \"out of memory\"",
    "<span class=\"c\"># 三处根除自动更新服务</span>",
    "<span class=\"k\">systemctl</span> disable --now unattended-upgrades.service",
    "<span class=\"k\">systemctl</span> disable --now apt-daily.timer",
    "<span class=\"s\">✔</span> swap 扩容 8G · 日志持久化"
  ],
